[{"path":"https://australianantarcticdivision.github.io/bgmfiles/authors.html","id":null,"dir":"","previous_headings":"","what":"Authors","title":"Authors and Citation","text":"Michael D. Sumner. Author, maintainer. Hadley Wickham. Contributor.","code":""},{"path":"https://australianantarcticdivision.github.io/bgmfiles/authors.html","id":"citation","dir":"","previous_headings":"","what":"Citation","title":"Authors and Citation","text":"Sumner M (2026). bgmfiles: Example BGM Files Atlantis Ecosystem Model. R package version 0.1.0.9001, https://github.com/AustralianAntarcticDivision/bgmfiles/.","code":"@Manual{,   title = {bgmfiles: Example BGM Files for the Atlantis Ecosystem Model},   author = {Michael D. Sumner},   year = {2026},   note = {R package version 0.1.0.9001},   url = {https://github.com/AustralianAntarcticDivision/bgmfiles/}, }"},{"path":"https://australianantarcticdivision.github.io/bgmfiles/index.html","id":"bgm-files-for-atlantis","dir":"","previous_headings":"","what":"Example BGM Files for the Atlantis Ecosystem Model","title":"Example BGM Files for the Atlantis Ecosystem Model","text":"raw-data package example .bgm files (box geometry model) Atlantis ecosystem model. Atlantis deterministic, biogeochemical, whole--ecosystem model: https://research.csiro.au/atlantis/. PLEASE NOTE: official source BGM use Atlantis. See https://github.com/AustralianAntarcticDivision/rbgm R package read files work box geometry. See https://github.com/AustralianAntarcticDivision/box-geometry-models project collects files used package.","code":""},{"path":"https://australianantarcticdivision.github.io/bgmfiles/index.html","id":"installation","dir":"","previous_headings":"","what":"Installation","title":"Example BGM Files for the Atlantis Ecosystem Model","text":"Install CRAN: Install develop version Github using devtools.","code":"install.packages(\"bgmfiles\") # install.packages(\"devtools\") devtools::install_github(\"AustralianAntarcticDivision/bgmfiles\")"},{"path":"https://australianantarcticdivision.github.io/bgmfiles/index.html","id":"usage","dir":"","previous_headings":"","what":"Usage","title":"Example BGM Files for the Atlantis Ecosystem Model","text":"List available raw files available package. needed filter based specific string pattern argument: package exists data package install example files, just one function bgmfiles runs file finding functions: don’t need load attach package find files, using installation mechanism convenient R use.","code":"library(bgmfiles) files <- bgmfiles() print(basename(files)) #>  [1] \"AEEC_poly_projETRS89_LAEA_snapped0p002.bgm\" #>  [2] \"ams71.bgm\"                                  #>  [3] \"antarctica_28.bgm\"                          #>  [4] \"antarctica_99.bgm\"                          #>  [5] \"CalCurrentV3_utm.bgm\"                       #>  [6] \"Final_CAM_Boxes_8.bgm\"                      #>  [7] \"GOM_BGM.bgm\"                                #>  [8] \"Guam_utm1.bgm\"                              #>  [9] \"JFRE_ll.bgm\"                                #> [10] \"JFRE_xy.bgm\"                                #> [11] \"NGOM.bgm\"                                   #> [12] \"Nordic02.bgm\"                               #> [13] \"VMPA_setas.bgm\" afiles <- bgmfiles(pattern = \"^antarc\") print(basename(afiles)) #> [1] \"antarctica_28.bgm\" \"antarctica_99.bgm\" list.files(system.file(\"extdata\", package = \"bgmfiles\"), pattern = NULL, full.names = TRUE, recursive = TRUE)"},{"path":"https://australianantarcticdivision.github.io/bgmfiles/index.html","id":"contribute","dir":"","previous_headings":"","what":"Contribute!","title":"Example BGM Files for the Atlantis Ecosystem Model","text":"like contribute example BGM files package: contribute repository example files https://github.com/AustralianAntarcticDivision/box-geometry-models submit suggestion issue package https://github.com/AustralianAntarcticDivision/bgmfiles/issues just get touch directly via email.","code":""},{"path":"https://australianantarcticdivision.github.io/bgmfiles/reference/bgmfiles.html","id":null,"dir":"Reference","previous_headings":"","what":"bgmfiles. — bgmfiles","title":"bgmfiles. — bgmfiles","text":"Raw data files maintained : https://github.com/AustralianAntarcticDivision/box-geometry-models.git Return full paths files extdata/bgm/ folder package.","code":""},{"path":"https://australianantarcticdivision.github.io/bgmfiles/reference/bgmfiles.html","id":"ref-usage","dir":"Reference","previous_headings":"","what":"Usage","title":"bgmfiles. — bgmfiles","text":"","code":"bgmfiles(pattern = NULL)"},{"path":"https://australianantarcticdivision.github.io/bgmfiles/reference/bgmfiles.html","id":"arguments","dir":"Reference","previous_headings":"","what":"Arguments","title":"bgmfiles. — bgmfiles","text":"pattern optional pattern string filter files returned, see list.files details","code":""},{"path":"https://australianantarcticdivision.github.io/bgmfiles/reference/bgmfiles.html","id":"value","dir":"Reference","previous_headings":"","what":"Value","title":"bgmfiles. — bgmfiles","text":"character vector file paths","code":""},{"path":"https://australianantarcticdivision.github.io/bgmfiles/reference/bgmfiles.html","id":"details","dir":"Reference","previous_headings":"","what":"Details","title":"bgmfiles. — bgmfiles","text":"package contains simple workflow update source repo install raw files extdata/ installed package.","code":""},{"path":[]},{"path":"https://australianantarcticdivision.github.io/bgmfiles/reference/bgmfiles.html","id":"author","dir":"Reference","previous_headings":"","what":"Author","title":"bgmfiles. — bgmfiles","text":"Maintainer: Michael D. Sumner mdsumner@gmail.com Authors: Michael D. Sumner mdsumner@gmail.com contributors: Hadley Wickham [contributor]","code":""},{"path":"https://australianantarcticdivision.github.io/bgmfiles/reference/bgmfiles.html","id":"ref-examples","dir":"Reference","previous_headings":"","what":"Examples","title":"bgmfiles. — bgmfiles","t